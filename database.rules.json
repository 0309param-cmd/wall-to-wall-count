{
  "rules": {
    "admins": {
      ".read": "auth != null",
      ".write": false
    },
    "counts": {
      ".read": "auth != null",
      ".indexOn": ["palletId", "locationId", "timestamp"],
      "$countId": {
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
